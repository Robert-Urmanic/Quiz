<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- No connection settings live here on purpose. The url, user and
             password come from the environment (DB_URL / DB_USER / DB_PASSWORD,
             or a single DATABASE_URL on a hosting platform) - see HibernateUtil.
             Startup fails loudly when they are missing, which is better than
             silently falling back to some forgotten test account. -->

        <property name="show_sql">true</property>
        <property name="format_sql">true</property>

        <property name="hbm2ddl.auto">update</property>

        <mapping class="org.example.entity.Chapter"/>
        <mapping class="org.example.entity.Subchapter"/>
        <mapping class="org.example.entity.Question"/>
    </session-factory>
</hibernate-configuration>